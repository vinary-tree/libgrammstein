@startuml code-pipeline
' CorrectionPipeline::analyze — six phases feeding a bounded streaming top-k collector.
' Render: plantuml -tsvg docs/diagrams/code-pipeline.puml
' Source of truth for Figure 1 in docs/components/code/pipeline.md
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam ArrowColor #37474F
skinparam activity {
  FontColor white
  FontStyle bold
  BorderColor #263238
  DiamondBackgroundColor #ECEFF1
  DiamondFontColor #263238
}
title CorrectionPipeline::analyze — six phases

start
:source: &str;
:**Phase 1 — Parse**
CodeParser::parse ▷ ParsedCode; <<#546E7A>>
:**Phase 2 — Tokenize**
CodeTokenizer ▷ Vec<CodeToken>; <<#EF6C00>>
if (config.full_semantic_analysis?) then (yes)
  :**Phase 3 — Analyze**
CodePropertyGraph::from_parsed_code; <<#EF6C00>>
else (no)
  :skip CPG; <<#ECEFF1>>
endif
:**Phase 4 — Diagnostics**
collect ERROR / MISSING spans; <<#C62828>>
partition "Phase 5 — Correct (streaming)" {
  :per token ▷ EnsembleCorrector.correct_token; <<#1565C0>>
  :if CPG ▷ EnsembleCorrector.analyze_full; <<#2E7D32>>
  :StreamingCorrectionCollector.add
prune < min_confidence · dedupe (start,end,replacement)
bounded min-heap of size max_corrections; <<#455A64>>
}
:**Phase 6 — Rank**
collector.finalize ▷ sort desc by confidence; <<#455A64>>
:**AnalysisResult**
{ source, has_parse_errors, error_count,
  tokens, corrections, diagnostics };
if (auto_apply_threshold set?) then (yes)
  :apply_corrections ▷ end-to-start splice; <<#EF6C00>>
else (no)
  :return suggestions;
endif
stop

@enduml
