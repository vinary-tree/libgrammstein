@startuml hybrid-scoring
' Hybrid scoring: parallel n-gram (blue) + embedding (green) branches fused by a
' strategy switch, memoized in a lock-free cache.
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam rectangle {
  FontColor white
  FontStyle bold
  BorderColor #263238
  roundCorner 12
}
skinparam ArrowColor #37474F
skinparam ArrowFontColor #37474F
title Hybrid Interpolation — score(w | h)

rectangle "**(context h, word w)**" as q #455A64
rectangle "**Lock-free cache**\nDashMap + LRU" as cache #1B6CA8

rectangle "**N-gram branch**\nℙₙ = ℙ_MKN(w | h)" as ngram #1565C0
rectangle "**Embedding branch**\nℙₑ ∝ cos(v_w, v_h) / τ" as embed #2E7D32

rectangle "**Strategy switch**" as strat #6A1B9A
rectangle "Linear\nα·ℙₙ + (1−α)·ℙₑ" as lin #6A1B9A
rectangle "Log-Linear\nexp(α·log ℙₙ + (1−α)·log ℙₑ)" as log #6A1B9A
rectangle "Fallback\nℙₙ if w∈V else ℙₑ" as fb #6A1B9A
rectangle "Dynamic\nα(h) grows with |h|" as dyn #6A1B9A

rectangle "**score**" as out #455A64

q --> cache : probe
cache --> ngram : miss
cache --> embed : miss
ngram --> strat
embed --> strat
strat --> lin
strat --> log
strat --> fb
strat --> dyn
lin --> out
log --> out
fb --> out
dyn --> out
out -[#1B6CA8,dashed]-> cache : insert
cache --> out : hit

@enduml
