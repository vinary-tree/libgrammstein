@startuml scoring-perplexity
' Corpus perplexity evaluation: how Perplexity::corpus_perplexity turns a stream of corpus
' sentences into PP, an OOV rate, and the token/sentence tallies. Blue = the statistical
' language-model core (the only place probabilities are computed); grey = corpus input;
' slate = the returned record; red = the one error exit.
' Render: plantuml -tsvg docs/diagrams/scoring-perplexity.puml
' Source of truth for Figure 1 in docs/components/scoring/overview.md and
' docs/api/scoring.md (the Perplexity section).
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam rectangle {
  FontColor white
  FontStyle bold
  BorderColor #263238
  roundCorner 12
}
skinparam ArrowColor #37474F
skinparam ArrowFontColor #37474F
title Corpus perplexity — Perplexity::corpus_perplexity(reader)

rectangle "**CorpusReader**\nreader.sentences()" as reader #546E7A
rectangle "**split_whitespace**\none sentence ⇒ tokens w₁ … w_N\n(empty sentences skipped)" as tok #546E7A

rectangle "**context window**\nhᵢ = w_(i−n+1) … w_(i−1)\nsaturating at the sentence start" as ctx #1565C0
rectangle "**NgramModel::log_prob**\nlog ℙ_MKN(wᵢ | hᵢ)\nModified Kneser-Ney backoff" as lp #1565C0
rectangle "**OOV probe**\nlog ℙ ≤ −ln |V|  ⇒  oov_count += 1" as oov #1E88E5

rectangle "**accumulate**\nΣ log ℙ · total_tokens N\noov_count · sentence_count" as acc #1565C0
rectangle "**PP = exp( −(1/N) · Σ log ℙ )**\nexponentiated per-token cross-entropy" as pp #1565C0

rectangle "**PerplexityResult**\nperplexity · total_log_prob · total_tokens\noov_count · oov_rate · sentence_count" as res #455A64
rectangle "**Err(Error::EmptyCorpus)**" as err #C62828

reader --> tok : per sentence
tok --> ctx : per token i
ctx --> lp
lp --> oov : probe
lp --> acc : add log ℙ
oov --> acc : add oov
acc --> pp : N > 0
acc -[#C62828]-> err : N = 0
pp --> res

note right of lp #E3F2FD
  Scoring reuses the model's ordinary
  query path — perplexity adds no
  smoothing of its own, so PP measures
  the model you actually ship.
end note

note right of pp #E3F2FD
  PP is the model's average branching
  factor. Lower is better; PP = |V| is
  exactly uniform guessing.
end note

legend right
  | Colour | Role |
  |<#546E7A> | corpus input (external) |
  |<#1565C0> | statistical LM core |
  |<#1E88E5> | OOV bookkeeping |
  |<#455A64> | returned record |
  |<#C62828> | error exit |
endlegend
@enduml
