@startuml latex-embedding-topk
' LaTeXEmbedder internals and the O(n log k) bounded min-heap used for top-k
' cosine-similarity nearest-neighbour selection.
' Render: plantuml -tsvg docs/diagrams/latex-embedding-topk.puml
' Source of truth for Figure 1 in docs/components/latex/embedding.md
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam rectangle {
  FontColor white
  FontStyle bold
  BorderColor #263238
  roundCorner 12
}
skinparam ArrowColor #37474F
top to bottom direction

legend top right
|= Concept |= Color |
| LaTeX embedder | <back:#EF6C00>        </back> |
| embeddings / vectors | <back:#2E7D32>        </back> |
| selection structure | <back:#6A1B9A>        </back> |
endlegend

rectangle "**LaTeXEmbedder**" as emb #EF6C00
rectangle "command_embeddings\nHashMap⟨String, CommandEmbedding⟩\nvector · frequency · category" as cmap #2E7D32
rectangle "equation_embeddings\nVec⟨EquationEmbedding⟩\nsource · vector" as evec #2E7D32
rectangle "unknown_embedding\nzero vector (OOV)" as unk #2E7D32

rectangle "query vector v_q" as q #455A64
rectangle "scan candidates\ncos(v_q, vᵢ) each" as scan #6A1B9A
rectangle "bounded min-heap\nBinaryHeap cap = k+1\nreversed order → smallest on top" as heap #6A1B9A
rectangle "top-k (name, sim)\nsorted desc" as out #455A64

emb --> cmap
emb --> evec
emb --> unk
q --> scan
cmap --> scan : vectors
evec --> scan : vectors
scan --> heap : push if sim > min
heap --> out : drain + sort

note right of heap
  If heap.len() < k push;
  else if sim > peek().min replace.
  Keeps only k live entries →
  O(n log k) vs O(n log n) full sort.
end note
@enduml
