@startuml code-tokenizer
' Tokenization: descend to AST leaves, classify by (text, node_kind), filter, enrich TokenContext.
' Render: plantuml -tsvg docs/diagrams/code-tokenizer.puml
' Source of truth for Figure 1 in docs/components/code/tokenizer.md
skinparam backgroundColor #FAFAFA
skinparam shadowing false
skinparam defaultTextAlignment center
skinparam linetype ortho
skinparam ArrowColor #37474F
skinparam activity {
  FontColor white
  FontStyle bold
  BorderColor #263238
}
title CodeTokenizer — Leaf Extraction, Classification, Context

start
:Tree + source
(tokenize · or tokenize_errors);
:traverse_node(node, depth, in_error)
in_error |= node.is_error(); <<#EF6C00>>
if (child_count == 0? ▷ leaf) then (yes)
  :text = node.utf8_text(source); <<#EF6C00>>
  :token_type = language.classify_token(text, node_kind); <<#1565C0>>
  if (Whitespace and not include_whitespace?
or Comment and not include_comments?) then (drop)
    :skip token; <<#C62828>>
  else (keep)
    :CodeToken { text, byte_offset, line, column,
token_type, node_kind }; <<#EF6C00>>
    :enrich TokenContext
depth · parent_node_type · sibling_types · in_error_region; <<#2E7D32>>
    :push CodeToken;
  endif
else (interior)
  :recurse into children (depth + 1); <<#EF6C00>>
endif
:**Vec<CodeToken>**
is_correctable() · is_in_error();
stop

@enduml
